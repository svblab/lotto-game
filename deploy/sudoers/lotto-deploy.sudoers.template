# Lotto Game deploy scripts — passwordless sudo for a dedicated deploy user.
# Generated by deploy/sudoers/install.sh — do not edit by hand.
#
# Deploy user: @DEPLOY_USER@
# Repository:  @REPO_ROOT@

Cmnd_Alias LOTTO_SYSTEMD_DEPLOY = \
    /bin/bash @REPO_ROOT@/deploy/systemd/install.sh *, \
    /bin/bash @REPO_ROOT@/deploy/systemd/update.sh *, \
    /bin/bash @REPO_ROOT@/deploy/systemd/remove.sh *, \
    /bin/bash @REPO_ROOT@/deploy/systemd/healthcheck.sh *, \
    @REPO_ROOT@/deploy/systemd/install.sh *, \
    @REPO_ROOT@/deploy/systemd/update.sh *, \
    @REPO_ROOT@/deploy/systemd/remove.sh *, \
    @REPO_ROOT@/deploy/systemd/healthcheck.sh *

Cmnd_Alias LOTTO_DOCKER_DEPLOY = \
    /bin/bash @REPO_ROOT@/deploy/docker/install.sh *, \
    /bin/bash @REPO_ROOT@/deploy/docker/remove.sh *, \
    /bin/bash @REPO_ROOT@/deploy/docker/healthcheck.sh *, \
    @REPO_ROOT@/deploy/docker/install.sh *, \
    @REPO_ROOT@/deploy/docker/remove.sh *, \
    @REPO_ROOT@/deploy/docker/healthcheck.sh *

@DEPLOY_USER@ ALL=(root) NOPASSWD: LOTTO_SYSTEMD_DEPLOY, LOTTO_DOCKER_DEPLOY
